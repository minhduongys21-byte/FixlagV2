--==================================================
-- XÓA HIỆU ỨNG & PHẲNG HÓA VẬT LIỆU
--==================================================

local function optimizeObject(obj)
    if not enabled or not obj then return end

    -- Xóa sạch các hiệu ứng và hình ảnh bề mặt gây lag
    if obj:IsA("PostEffect") 
        or obj:IsA("Atmosphere") 
        or obj:IsA("Clouds") 
        or obj:IsA("ParticleEmitter") 
        or obj:IsA("Trail") 
        or obj:IsA("Beam") 
        or obj:IsA("Fire") 
        or obj:IsA("Smoke") 
        or obj:IsA("Sparkles") 
        or obj:IsA("Light") 
        or obj:IsA("Decal") 
        or obj:IsA("Texture") 
        or obj:IsA("SurfaceAppearance") then
        pcall(function()
            obj:Destroy()
        end)
    elseif obj:IsA("BasePart") then
        if not saved[obj] then
            saved[obj] = {
                Material = obj.Material,
                Reflectance = obj.Reflectance,
                CastShadow = obj.CastShadow
            }
        end

        pcall(function()
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
        end)
    end
end

--==================================================
-- BẬT FIX LAG
--==================================================

local oldShadows
local oldDiffuse
local oldSpecular

local function enableFixLag()
    enabled = true

    oldShadows = Lighting.GlobalShadows
    oldDiffuse = Lighting.EnvironmentDiffuseScale
    oldSpecular = Lighting.EnvironmentSpecularScale

    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0

    for _, obj in ipairs(Lighting:GetDescendants()) do
        optimizeObject(obj)
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        optimizeObject(obj)
    end

    connections[#connections + 1] = Workspace.DescendantAdded:Connect(function(obj)
        if enabled then
            task.defer(function()
                optimizeObject(obj)
            end)
        end
    end)

    connections[#connections + 1] = Lighting.DescendantAdded:Connect(function(obj)
        if enabled then
            task.defer(function()
                optimizeObject(obj)
            end)
        end
    end)

    button.Text = "FIX LAG : ON"
    button.TextColor3 = Color3.fromRGB(70, 255, 120)
    button.BackgroundColor3 = Color3.fromRGB(15, 55, 30)
    outline.Color = Color3.fromRGB(70, 255, 120)
    status.Text = "STATUS: ULTRA BOOST"
    status.TextColor3 = Color3.fromRGB(70, 255, 120)
end

--==================================================
-- TẮT FIX LAG VÀ KHÔI PHỤC
--==================================================

local function disableFixLag()
    enabled = false

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)

    for obj, properties in pairs(saved) do
        if obj and obj.Parent then
            for property, oldValue in pairs(properties) do
                pcall(function()
                    obj[property] = oldValue
                end)
            end
        end
    end

    table.clear(saved)

    if oldShadows ~= nil then
        Lighting.GlobalShadows = oldShadows
    end
    if oldDiffuse ~= nil then
        Lighting.EnvironmentDiffuseScale = oldDiffuse
    end
    if oldSpecular ~= nil then
        Lighting.EnvironmentSpecularScale = oldSpecular
    end

    button.Text = "FIX LAG : OFF"
    button.TextColor3 = Color3.fromRGB(255, 50, 65)
    button.BackgroundColor3 = Color3.fromRGB(45, 20, 25)
    outline.Color = Color3.fromRGB(255, 30, 50)
    status.Text = "STATUS: RESTORED"
    status.TextColor3 = Color3.fromRGB(180, 180, 190)
end

--==================================================
-- NÚT ON/OFF
--==================================================

button.Activated:Connect(function()
    if enabled then
        disableFixLag()
    else
        enableFixLag()
    end
end)

--==================================================
-- KÉO MENU BẰNG CHUỘT HOẶC CẢM ỨNG
--==================================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

print("DAT CHUA FIX LAG (ULTRA BOOST) loaded successfully!")
